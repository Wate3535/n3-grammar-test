# Shu faylni .env.local nomi bilan nusxalang va qiymatlarni to'ldiring.
# Xuddi shu 4 ta o'zgaruvchini Vercel → Project → Settings → Environment Variables ga ham qo'shing.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# "service_role" (secret) kalit. Hech kimga bermang, faqat serverda ishlatiladi.
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (/admin) paroli
ADMIN_PASSWORD=

# Cookie imzosi uchun tasodifiy uzun satr (kamida 32 belgi).
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
